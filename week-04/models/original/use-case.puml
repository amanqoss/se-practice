@startuml
left to right direction

actor Student
actor Administrator

rectangle "Smart Campus Study Room Booking System" {
    usecase "Book room" as UC1
    usecase "View availability" as UC2
    usecase "Cancel own booking" as UC3
    usecase "Block room" as UC4
    usecase "Unblock room" as UC5
    usecase "Review usage" as UC6
    usecase "Send booking confirmation" as UC7
}

Student --> UC1
Student --> UC2
Student --> UC3

Administrator --> UC4
Administrator --> UC5
Administrator --> UC6

UC1 ..> UC7 : <<include>>

@enduml