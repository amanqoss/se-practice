@startuml
title Smart Campus - Book Room (US-01)

actor Student
participant BookingService
database BookingRepository

note right of Student
Assumptions:
- Requesting student identity is known.
- The selected room exists.
- Student supplies the requested time slot.
- Touching bookings do not overlap.
end note

Student -> BookingService : bookRoom(studentId, roomId, startTime, endTime)
activate BookingService

BookingService -> BookingService : validateTime(startTime, endTime)

note right of BookingService
R1: Start must be in the future.
Duration must be > 0 and <= 2 hours.
end note

alt Invalid time or duration
    BookingService --> Student : bookingRejected("Invalid time or duration")
else Valid time and duration

    BookingService -> BookingRepository : isRoomBlocked(roomId)
    activate BookingRepository
    BookingRepository --> BookingService : blocked
    deactivate BookingRepository

    alt Room blocked (R3)
        BookingService --> Student : bookingRejected("Room is blocked")
    else Room not blocked

        BookingService -> BookingRepository : tryCreateBooking(studentId, roomId, startTime, endTime)
        activate BookingRepository

        note right of BookingRepository
        R2: Reject overlapping active bookings.
        R3: Recheck the blocked state atomically.
        Save only if all constraints still hold.
        end note

        alt Reservation succeeds
            BookingRepository --> BookingService : bookingCreated(bookingId)
            deactivate BookingRepository

            BookingService -> BookingService : generateConfirmation(bookingId)

            note right of BookingService
            R4: A successful booking
            produces a confirmation.
            end note

            BookingService --> Student : bookingConfirmed(bookingId, confirmation)

        else Reservation unavailable or blocked
            BookingRepository --> BookingService : reservationRejected(reason)
            deactivate BookingRepository
            BookingService --> Student : bookingRejected(reason)
        end
    end
end

deactivate BookingService
@enduml